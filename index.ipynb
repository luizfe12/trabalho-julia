# 5 — Criando as mesmas bases em R (código R)

```r
```{r}
# Gera mesmo tipo de bases em R — opcional (se já foram criadas por Julia, pule)
set.seed(123)
N <- 100000

df_peq <- data.frame(
  id = 1:10,
  nome = c("Ana","Bruno","Carla","Diego","Eva","Fernando","Gabi","Hugo","Iris","Joao"),
  idade = sample(18:60, 10, replace=TRUE),
  salario = sample(seq(2500, 9000, by=50), 10, replace=TRUE)
)
readr::write_csv(df_peq, "dados_pequenos.csv")

df_tab <- data.frame(
  produto = c("A","B","C","D","E"),
  preco = sample(20:100, 5, replace=TRUE),
  estoque = sample(1:200, 5, replace=TRUE)
)
readr::write_tsv(df_tab, "dados_tab.txt")

# CSV grande
library(dplyr)
df_grande <- data.frame(
  id = 1:N,
  categoria = sample(c("A","B","C","D"), N, replace=TRUE),
  valor = runif(N, min=1000, max=5000),
  quantidade = sample(1:100, N, replace=TRUE)
)
readr::write_csv(df_grande, "dados_grandes.csv")

# XLSX
writexl::write_xlsx(list(Planilha1 = df_peq), "dados.xlsx")

cat("Arquivos (R) escritos: dados_pequenos.csv, dados_tab.txt, dados_grandes.csv, dados.xlsx\n")
```
