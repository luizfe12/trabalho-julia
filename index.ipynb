# 3 — Criando as bases (Julia) {data-background-color="#ffffff"}

```julia
```{julia}
using CSV, DataFrames, XLSX, Random
Random.seed!(123)

# CSV pequeno
df_peq = DataFrame(
  id = 1:10,
  nome = ["Ana","Bruno","Carla","Diego","Eva","Fernando","Gabi","Hugo","Iris","João"],
  idade = rand(18:60, 10),
  salario = rand(2500.0:50.0:9000.0, 10)
)
CSV.write("dados_pequenos.csv", df_peq)

# TXT com tab
df_tab = DataFrame(
  produto = ["A","B","C","D","E"],
  preco = rand(20.0:1.0:100.0, 5),
  estoque = rand(1:200, 5)
)
CSV.write("dados_tab.txt", df_tab; delim='\t')

# CSV grande: 100k linhas
N = 100_000
df_grande = DataFrame(
  id = 1:N,
  categoria = rand(["A","B","C","D"], N),
  valor = rand(1000.0:0.1:5000.0, N),
  quantidade = rand(1:100, N)
)
CSV.write("dados_grandes.csv", df_grande)

# XLSX (aba Planilha1)
XLSX.writetable("dados.xlsx", collect(eachcol(df_peq)), String.(names(df_peq)); sheetname="Planilha1", overwrite=true)

println("Arquivos criados: dados_pequenos.csv, dados_tab.txt, dados_grandes.csv, dados.xlsx")
```
```

