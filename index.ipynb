# 6 — Importando em R e benchmark

```r
```{r}
library(data.table)
library(readr)
library(readxl)
library(microbenchmark)

# Leitura
df_csv_r  <- readr::read_csv("dados_pequenos.csv")
df_txt_r  <- readr::read_tsv("dados_tab.txt")
df_big_r  <- data.table::fread("dados_grandes.csv")
df_xlsx_r <- readxl::read_excel("dados.xlsx", sheet = "Planilha1")

cat("CSV pequeno — primeiras linhas:\n")
print(head(df_csv_r, 5))
cat("TXT (tab) — primeiras linhas:\n")
print(head(df_txt_r,5))
cat("CSV grande — dimensão:\n")
print(dim(df_big_r))
cat("XLSX — primeiras linhas:\n")
print(head(df_xlsx_r,5))

# Benchmark entre fread (data.table) e readr::read_csv
# Warmup
tmp1 <- data.table::fread("dados_grandes.csv")
tmp2 <- readr::read_csv("dados_grandes.csv", show_col_types = FALSE)

res <- microbenchmark(
  fread = data.table::fread("dados_grandes.csv"),
  readr = readr::read_csv("dados_grandes.csv", show_col_types = FALSE),
  times = 5
)
print(summary(res))

median_ms <- summary(res)$median / 1e6
cat("\nR — median (ms) por método:\n")
print(data.frame(expr=summary(res)$expr, median_ms = median_ms))
```
```

