# 7 — Python: leitura e benchmark

```python
```{python}
import pandas as pd
import time
import statistics

# Leitura (assume que arquivos existem no diretório)
print("CSV pequeno — head:")
print(pd.read_csv("dados_pequenos.csv").head())
print("\nTXT (tab) — head:")
print(pd.read_csv("dados_tab.txt", sep="\t").head())
print("\nCSV grande — shape:")
print(pd.read_csv("dados_grandes.csv").shape)
print("\nXLSX — head:")
print(pd.read_excel("dados.xlsx", sheet_name="Planilha1").head())

# Benchmark simples com pandas
def load_pandas():
    pd.read_csv("dados_grandes.csv")

# warmup
load_pandas()

times = []
for _ in range(5):
    start = time.perf_counter()
    load_pandas()
    end = time.perf_counter()
    times.append(end - start)

print("\nPython (pandas) — tempos (s):", times)
print("mean (s):", statistics.mean(times))
print("median (s):", statistics.median(times))
print("min (s):", min(times))
```
```

